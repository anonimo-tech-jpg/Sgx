-- ============================================================
-- PESQUISA EM LOTES
-- ============================================================
local MAX_RESULTS = 120
local searchQueued = false
local searchToken = 0

local function loadChunks(items, factory, chunkSize, onStep)
	chunkSize = chunkSize or 15
	local i = 1
	local total = #items
	local myToken = searchToken

	local function step()
		if myToken ~= searchToken then return end
		local limit = math.min(i + chunkSize - 1, total)
		for j = i, limit do
			pcall(factory, items[j])
		end
		i = limit + 1
		RefreshLayout()
		if onStep then onStep() end
		if i <= total then
			task.wait()
			step()
		end
	end
	task.spawn(step)
end

local function doSearch()
	searchToken += 1
	local myToken = searchToken
	local texto = string.lower(SearchBar.Text)

	if texto == "" then
		for _, obj in ipairs(Frame:GetChildren()) do
			if obj:IsA("ImageButton") then
				obj.Visible = (obj:GetAttribute("ItemMode") == currentMode)
			end
		end
		ReorderItems()
		updateVisible()
		RefreshLayout()
		return
	end

	local dataToSearch = (currentMode == "Emotes") and AllEmotesData or AllAnimsData
	local isEmote = (currentMode == "Emotes")

	for _, obj in ipairs(Frame:GetChildren()) do
		if obj:IsA("ImageButton") and obj:GetAttribute("ItemMode") == currentMode then
			obj.Visible = false
		end
	end

	local matches = {}
	local count = 0
	for _, item in ipairs(dataToSearch) do
		local itemName = string.lower(item.name or "")
		local itemId = tostring(item.id)
		if string.find(itemName, texto, 1, true) or string.find(itemId, texto, 1, true) then
			table.insert(matches, item)
			count += 1
			if count >= MAX_RESULTS then break end
		end
	end

	local factory = isEmote and makeEmoteCard or makeAnimCard
	local toCreate = {}
	local idset = {}
	for _, item in ipairs(matches) do
		local idStr = tostring(item.id)
		idset[idStr] = true
		local loaded = isEmote and LoadedEmotes[idStr] or LoadedAnims[idStr]
		if not loaded then table.insert(toCreate, item) end
	end

	for _, obj in ipairs(Frame:GetChildren()) do
		if obj:IsA("ImageButton") and obj:GetAttribute("ItemMode") == currentMode then
			if idset[obj.Name] then obj.Visible = true end
		end
	end
	ReorderItems()
	updateVisible()

	if #toCreate > 0 then
		loadChunks(toCreate, factory, 15, function()
			if myToken ~= searchToken then return end
			for _, obj in ipairs(Frame:GetChildren()) do
				if obj:IsA("ImageButton") and obj:GetAttribute("ItemMode") == currentMode then
					if idset[obj.Name] then obj.Visible = true end
				end
			end
			ReorderItems()
			updateVisible()
		end)
	end
end

SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
