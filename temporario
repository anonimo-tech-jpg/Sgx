local FAVORITES_FILE = "EmoteFavorites.json"
local ANIM_FAVORITES_FILE = "AnimPacksFavorites.json"

local function safeRead(path)
	if readfile and isfile and isfile(path) then
		local ok, data = pcall(readfile, path)
		if ok then return data end
	end
end
local function safeWrite(path, data)
	if writefile then pcall(writefile, path, data) end
end

do
	local raw = safeRead(FAVORITES_FILE)
	if raw then
		local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
		if ok and type(d) == "table" then Favorites = d end
	end
	raw = safeRead(ANIM_FAVORITES_FILE)
	if raw then
		local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
		if ok and type(d) == "table" then AnimFavorites = d end
	end
end

local function SaveFavorites(mode)
	if mode == "Emotes" then
		safeWrite(FAVORITES_FILE, HttpService:JSONEncode(Favorites))
	else
		safeWrite(ANIM_FAVORITES_FILE, HttpService:JSONEncode(AnimFavorites))
	end
end

