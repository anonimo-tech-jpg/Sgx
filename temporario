local CATALOG_EMOTES = "https://raw.githubusercontent.com/psychoSAGAZ/Anima-es-e-emotes/refs/heads/main/EmoteSniper.json"
local CATALOG_ANIMS  = "https://raw.githubusercontent.com/psychoSAGAZ/Anima-es-e-emotes/refs/heads/main/AnimationSniper.json"

local function fetchJSON(url)
	local ok, response = pcall(game.HttpGet, game, url)
	if not ok or not response then return nil end
	local ok2, parsed = pcall(function() return HttpService:JSONDecode(response) end)
	if not ok2 then return nil end
	return parsed
end

-- ── EMOTES: últimos 300 ──
task.spawn(function()
	local parsed = fetchJSON(CATALOG_EMOTES)
	if not parsed or not parsed.data then return end
	AllEmotesData = parsed.data

	local total = #parsed.data
