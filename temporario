-- LAZY THUMBNAIL
-- ============================================================
local visibleCards = {}

local function isCardVisible(card)
	local cp = Frame.CanvasPosition
	local cs = Frame.AbsoluteSize
	local cellY = card.Position.Y.Offset
	return cellY + 84 >= cp.Y - 84 and cellY <= cp.Y + cs.Y + 84
end

local function updateVisible()
	for card, loader in pairs(visibleCards) do
		if card.Parent and card.Visible and isCardVisible(card) then
			loader()
			visibleCards[card] = nil
		end
	end
end

Frame:GetPropertyChangedSignal("CanvasPosition"):Connect(updateVisible)
Frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateVisible)

local function queueLazy(card, loader)
	visibleCards[card] = loader
	updateVisible()
end

-- ============================================================
-- PLAY EMOTE
-- ============================================================
local CurrentTrack
local AnimationCache = {}
local PlayToken = 0

local function PlayEmote(assetId)
	if not assetId then return end
	PlayToken += 1
	local myToken = PlayToken

	local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid then return end

	if CurrentTrack then
		pcall(function() CurrentTrack:Stop() end)
		CurrentTrack = nil
	end

	local function play(animId)
		if myToken ~= PlayToken then return end
		local Animation = Instance.new("Animation")
		Animation.AnimationId = animId
		local ok, Track = pcall(function() return Humanoid:LoadAnimation(Animation) end)
		if not ok or not Track then return end
		Track.Priority = Enum.AnimationPriority.Action
		Track.Looped = true
		Track:Play()
		CurrentTrack = Track
	end

	local cached = AnimationCache[assetId]
	if cached then play(cached) return end

	task.spawn(function()
		local animId
		local ok, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. tostring(assetId))
		end)
		if ok and objects and #objects > 0 then
			local obj = objects[1]
			if obj:IsA("Animation") then
				animId = obj.AnimationId
			else
				local a = obj:FindFirstChildOfClass("Animation")
				if a then animId = a.AnimationId end
			end
		end
		if not animId then
			animId = "rbxassetid://" .. tostring(assetId)
		end
		AnimationCache[assetId] = animId
		play(animId)
	end)
end

-- ============================================================
-- ANIMATION PACK
-- ============================================================
local LastEquippedPack = nil
local TrackExtractCache = {}

local function extractValidAnimationTracks(assetId, descProp)
	local key = tostring(assetId) .. "|" .. descProp
	if TrackExtractCache[key] then
		local out = {}
		for _, v in ipairs(TrackExtractCache[key]) do
			table.insert(out, v:Clone())
		end
		return out
	end

	local results = {}
	if not assetId or assetId == 0 then return results end

	pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc[descProp] = tonumber(assetId)
		local dummy = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		local animate = dummy:FindFirstChild("Animate")
		if animate then
			local folderName = string.lower(string.gsub(descProp, "Animation", ""))
			local folder = animate:FindFirstChild(folderName)
			if folder then
				for _, child in ipairs(folder:GetChildren()) do
					if child:IsA("Animation") and child.AnimationId ~= "" then
						table.insert(results, child:Clone())
					end
				end
			end
		end
		dummy:Destroy()
	end)

	if #results == 0 then
		local backup = Instance.new("Animation")
		backup.AnimationId = "rbxassetid://" .. tostring(assetId)
		table.insert(results, backup)
	end

	TrackExtractCache[key] = results
	return results
end

local function ApplyAnimationPack(pack)
	if not pack then return end
	LastEquippedPack = pack

	local character = LocalPlayer.Character
	if not character then return end

	local animateScript = character:FindFirstChild("Animate")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not animateScript or not humanoid then return end

	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		pcall(function() track:Stop(0) end)
	end
	animateScript.Disabled = true

	local items = pack.bundledItems or {}
	local mapping = {
		idle  = { id = items["Idle"],  prop = "IdleAnimation" },
		walk  = { id = items["Walk"],  prop = "WalkAnimation" },
		run   = { id = items["Run"],   prop = "RunAnimation" },
		jump  = { id = items["Jump"],  prop = "JumpAnimation" },
		fall  = { id = items["Fall"],  prop = "FallAnimation" },
		climb = { id = items["Climb"], prop = "ClimbAnimation" },
		swim  = { id = items["Swim"],  prop = "SwimAnimation" },
	}

	for folderName, info in pairs(mapping) do
		if info.id then
			local folder = animateScript:FindFirstChild(folderName)
			if folder then
				for _, child in ipairs(folder:GetChildren()) do
					if child:IsA("Animation") then child:Destroy() end
				end
				local tracks = extractValidAnimationTracks(info.id, info.prop)
				for _, t in ipairs(tracks) do t.Parent = folder end
			end
		end
	end

	task.defer(function() animateScript.Disabled = false end)
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
	local animateScript = newChar:WaitForChild("Animate", 10)
	local humanoid = newChar:WaitForChild("Humanoid", 10)
	if animateScript and humanoid and LastEquippedPack then
		task.wait(0.5)
		ApplyAnimationPack(LastEquippedPack)
	end
end)

-- ============================================================
-- PARAR EMOTE AO ANDAR
-- ============================================================
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	if MovimentoAtivo or not CurrentTrack then return end
	acc += dt
	if acc < 0.1 then return end
	acc = 0

	local Character = LocalPlayer.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid then return end

	local Moving = Humanoid.MoveDirection.Magnitude > 0.1
	local State = Humanoid:GetState()
	if Moving or State == Enum.HumanoidStateType.Jumping
		or State == Enum.HumanoidStateType.Freefall then
		pcall(function() CurrentTrack:Stop() end)
		CurrentTrack = nil
	end
end)

